[Unit]
Description=AlisaGPT Alice API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alisagpt
Group=alisagpt
WorkingDirectory=/opt/alisagpt
ExecStart=/opt/alisagpt/.venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/alisagpt/data

[Install]
WantedBy=multi-user.target

